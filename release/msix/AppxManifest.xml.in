<?xml version="1.0" encoding="utf-8"?>
<!--
  Lothal, packaged for the Microsoft Store.

  This is a template, not a manifest: package_msix.ps1 substitutes the at-sign-delimited
  upper-case placeholders below and writes the real AppxManifest.xml into the staging directory.
  Do not write one of those placeholder tokens out in full anywhere in this comment block — the
  script's "nothing was left unsubstituted" guard scans the whole file and cannot tell prose
  from markup, so a token quoted in a comment fails the build. Nothing here should be
  hand-edited with real values, because three of them are account secrets-by-convention that
  live in Partner Center and CI variables rather than in a public repo.

  ===========================================================================
  THE THREE IDENTITY FIELDS
  ===========================================================================

  Identity/@Name, Identity/@Publisher and PublisherDisplayName are not descriptive. They are
  matched byte-for-byte against the values on the product's "Product Identity" page in Partner
  Center, and a package whose identity differs by so much as a space is rejected at ingestion
  with an error that names the field but not the difference. Copy them from that page; do not
  retype them, and do not guess the CN= string from the company name — Microsoft assigns it.

  ===========================================================================
  WHY FULL TRUST AND NOT A REAL UWP APP
  ===========================================================================

  Godot 4 has no UWP export, and Lothal could not use one if it did: the Rust core is a plain
  MSVC cdylib and the licence check reads a file from an ordinary user directory. This is a
  Desktop Bridge package — a normal Win32 .exe inside an MSIX container, which is what
  runFullTrust declares. It is a fully supported Store submission, not a workaround.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@IDENTITY_PUBLISHER@"
    Version="@PACKAGE_VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lothal</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <!--
    10.0.17763.0 (Windows 10 1809) is the floor because it is the oldest release still taking
    Store updates, not because anything here needs it. Raising it silently removes machines from
    the listing, so it moves only on purpose.
  -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Lothal" Executable="Lothal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lothal"
        Description="FPV drone design workbench and flight simulator"
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png" />
      <!--
        No uap:DefaultTile. The two logos above are the only ones MSIX actually requires, and
        every DefaultTile attribute is documented as optional — but MakeAppx enforces a rule the
        schema does not state: specifying Square310x310Logo without Wide310x150Logo is a hard
        validation failure. A wide tile needs a 310x150 letterboxed asset that a square app icon
        does not crop to, and the only thing bought by producing one is a larger Start tile, which
        is cosmetic and barely surfaced on Windows 11. Dropping the element removes the whole
        class of cross-attribute constraint from this manifest.
      -->
    </Application>
  </Applications>

  <!--
    runFullTrust is the capability that makes a packaged Win32 app legal; it is "restricted",
    which for a Store submission means it is granted on the strength of the account rather than
    needing separate approval, and every Desktop Bridge package declares it.

    runFullTrust is the ONLY capability, because a Store build of Lothal makes no network
    requests at all. That is worth stating plainly, because it is surprising: HTTPRequest appears
    in exactly one file, update_notice.gd, and the "store" feature tag compiles it out of this
    build. Activation is not an exception — the licence is verified offline against a public key
    baked into the binary, and the activation page is opened in the user's own browser with
    OS.shell_open, which is the shell's network use and not the app's.

    So internetClient was declared here and then removed. An unused capability is a certification
    finding, and it is also a lie told to the user: the Store listing renders it as "Uses your
    internet connection" on an app that does not. If a future build ever makes a request from
    inside the process, this is where that has to be declared again.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
