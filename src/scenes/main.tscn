[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://src/scenes/main.gd" id="1"]

; R2.1: a physical (Rayleigh + Mie) sky. The sun disc in it is placed by the scene's one DirectionalLight3D
; (sky_mode LIGHT_AND_SKY), so the light that casts the shadows and the sun you see are the same direction by construction.
; B3/E1: the sky is also the only light inside a shadow (ambient source = sky). At energy 1.0 its irradiance was about a
; tenth of what a clear sky gives next to this 1.9 sun: the core of a gate's shadow measured 0.18 of the lit grass on
; screen (tests/probe_shadow_ratio.gd), i.e. black. A clear sky at 26 deg sun elevation supplies roughly 20-30% of the
; horizontal irradiance as diffuse light (ESTIMATE from clear-sky diffuse fractions), which reads near 0.45 on screen after
; the sRGB curve; energy 5.0 measured 0.50. Raising the sky's own radiance (not a flat fill colour) keeps the shadow blue and directional, and keeps
; the sky you see and the sky that lights the ground one quantity. Calibrated with the probe, not derived.
[sub_resource type="PhysicalSkyMaterial" id="PhysicalSkyMaterial_sky"]
rayleigh_coefficient = 2.0
mie_coefficient = 0.004
mie_eccentricity = 0.8
turbidity = 8.0
sun_disk_scale = 1.0
ground_color = Color(0.30, 0.36, 0.24, 1)
energy_multiplier = 5.0

[sub_resource type="Sky" id="Sky_sky"]
sky_material = SubResource("PhysicalSkyMaterial_sky")

; Exposure follows the scene's brightness, bounded so a look at the sun does not black the field out.
[sub_resource type="CameraAttributesPractical" id="CameraAttributes_world"]
auto_exposure_enabled = true
auto_exposure_scale = 0.4
auto_exposure_speed = 1.5
auto_exposure_min_sensitivity = 60.0
auto_exposure_max_sensitivity = 600.0

; ACES tonemap. Ambient and reflections come from the sky. Fog: exponential extinction (density 0.0009 /m is about 4.3 km
; meteorological visibility, an ESTIMATE for a hazy day) with aerial perspective so distant hills take the sky's colour,
; and a thin ground haze.
[sub_resource type="Environment" id="Environment_world"]
background_mode = 2
sky = SubResource("Sky_sky")
ambient_light_source = 3
reflected_light_source = 2
tonemap_mode = 3
ssao_enabled = true
ssao_radius = 0.35
ssao_intensity = 1.6
ssao_power = 1.5
ssao_detail = 0.4
glow_enabled = true
glow_intensity = 0.3
; B3: no whole-frame bloom (it laid a haze over every shot); glow stays for the emissive gates only.
glow_bloom = 0.0
adjustment_enabled = true
adjustment_contrast = 1.04
adjustment_saturation = 1.0
fog_enabled = true
fog_light_color = Color(0.66, 0.76, 0.86, 1)
fog_light_energy = 1.0
fog_sun_scatter = 0.25
fog_density = 0.0009
fog_aerial_perspective = 0.7
fog_sky_affect = 0.35
fog_height = 0.0
fog_height_density = 0.01

[node name="Main" type="Node3D"]
script = ExtResource("1")

; The airframe under Drone is NOT authored here. It is generated at runtime by
; AirframeModel from the same Build the physics reads, so the frame, motors and props on
; screen are the parts that were chosen in Lab (labs-and-sim.md §3). What used to sit here
; was a BoxMesh plus four cylinders with the 5" arm's motor positions baked in as 0.0778 and
; no propellers at all, which meant choosing the 7" frame flew a 150 mm arm and drew a 5"
; prop-less box.
[node name="Drone" type="Node3D" parent="."]

[node name="Camera3D" type="Camera3D" parent="."]
current = true
near = 0.02
far = 600.0

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_world")
camera_attributes = SubResource("CameraAttributes_world")

; Sun: 26 degrees above the horizon. PSSM with 4 splits out to 300 m; the split offsets (fractions of that 300 m) put
; the first split at 12 m, which is the FPV-low range where the drone's own shadow is judged, then 36 m, then 105 m.
[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8138443, -0.2547300, 0.5222739, 0.0000000, 0.8987940, 0.4383711, -0.5810830, -0.3567659, 0.7314784, 0, 3, 0)
light_color = Color(1, 0.96, 0.88, 1)
light_energy = 1.9
light_angular_distance = 0.5
shadow_enabled = true
shadow_bias = 0.03
shadow_normal_bias = 1.2
shadow_blur = 1.2
sky_mode = 0
directional_shadow_mode = 2
directional_shadow_split_1 = 0.04
directional_shadow_split_2 = 0.12
directional_shadow_split_3 = 0.35
; Blend off (R2.1c): Forward+ blends cascades with a per-pixel dither, which read as stipple on a far tree's shadow.
directional_shadow_blend_splits = false
directional_shadow_fade_start = 0.9
directional_shadow_max_distance = 300.0

; The ground has no mesh and no shape authored here (F5). Both come from TerrainMesh, built from
; the selected site's Terrain at _ready and on every adopt_selected_course() — a shipped plane and
; box here would be a second, un-syncable copy of the site's shape.
[node name="Ground" type="StaticBody3D" parent="."]

[node name="GroundMesh" type="MeshInstance3D" parent="Ground"]

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ground"]
